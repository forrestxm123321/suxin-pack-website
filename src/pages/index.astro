---
/**
 * 首页 - 塑料包装行业科技工业风
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AdvantageCard from '../components/AdvantageCard.astro';
import ProductCard from '../components/ProductCard.astro';
import siteData from '../data/site.json';
const { SITE, ADVANTAGES, INDUSTRIES, COMPANY_STATS, PRODUCTION_FLOW, KEYWORDS } = siteData;
import productsData from '../data/products.json';
import categoriesData from '../data/categories.json';
const categories = (categoriesData as any).categories || categoriesData;
import casesData from '../data/cases.json';
const PRODUCTS = productsData.items;
const PRODUCT_CATEGORIES = categories;
const CASES = casesData.items;

const pageTitle = 'VCI气相防锈袋源头生产厂家_工业塑料包装袋一站式供应商';
const pageDescription = SITE.description;
const pageKeywords = KEYWORDS.join(', ');
const featuredProducts = PRODUCTS.slice(0, 6);
const featuredCases = CASES.slice(0, 3);
const faqQuestions = SITE.faqQuestions || [];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  ogType="website"
  schemaTypes={[
    { type: 'WebSite', data: {} },
    { type: 'FAQPage', data: { questions: faqQuestions } },
    { type: 'LocalBusiness', data: {} },
  ]}
>
  <!-- Hero -->
  <Hero />

  <!-- 数据统计 -->
  <section class="relative -mt-10 z-10 pb-12">
    <div class="container-page">
      <div class="bg-white rounded-2xl shadow-elevated border border-gray-100 p-6 sm:p-8 grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-8">
        {COMPANY_STATS.map((stat) => (
          <div class="text-center">
            <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-gradient">{stat.value}</div>
            <div class="text-xs sm:text-sm text-gray-500 mt-1 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 核心优势 -->
  <section class="section-sm bg-gray-50/50">
    <div class="container-page">
      <div class="text-center">
        <span class="section-badge">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812z" clip-rule="evenodd"/></svg>
          核心优势
        </span>
      </div>
      <h2 class="section-title">为什么选择塑鑫包装？</h2>
      <p class="section-subtitle">六大核心优势，数百家制造企业的共同选择</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {ADVANTAGES.map((adv, i) => (
          <AdvantageCard icon={adv.icon} title={adv.title} description={adv.description} index={i} />
        ))}
      </div>
    </div>
  </section>

  <!-- 生产工艺流程 -->
  <section class="section">
    <div class="container-page">
      <div class="text-center">
        <span class="section-badge">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
          生产实力
        </span>
      </div>
      <h2 class="section-title">吹膜 · 印刷 · 制袋 全流程自主完成</h2>
      <p class="section-subtitle">从原料到成品，六大工序严格品控把关</p>

      <!-- 桌面流程线 -->
      <div class="hidden lg:grid grid-cols-6 gap-3 relative mb-8">
        {PRODUCTION_FLOW.map((item, i) => (
          <div class="text-center relative">
            {i < PRODUCTION_FLOW.length - 1 && (
              <div class="absolute top-9 left-[calc(50%+1.5rem)] w-[calc(100%-2rem)] h-0.5">
                <div class="h-full bg-gradient-to-r from-primary-300 to-primary-100"></div>
              </div>
            )}
            <div class="relative z-10 w-[72px] h-[72px] mx-auto bg-white rounded-2xl border-2 border-primary-200 flex items-center justify-center text-2xl font-extrabold text-primary-700 shadow-sm mb-4 group-hover:border-primary-500 group-hover:shadow-glow transition-all duration-300">
              {item.step}
            </div>
            <h4 class="font-bold text-gray-900 text-sm mb-1">{item.title}</h4>
            <p class="text-xs text-gray-400 leading-snug">{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- 移动端列表 -->
      <div class="lg:hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
        {PRODUCTION_FLOW.map((item) => (
          <div class="flex items-start gap-4 bg-white rounded-2xl p-5 border border-gray-100 shadow-card hover:shadow-elevated transition-all duration-300">
            <div class="shrink-0 w-12 h-12 bg-gradient-to-br from-primary-500 to-primary-600 text-white rounded-2xl flex items-center justify-center text-lg font-extrabold shadow-sm">
              {item.step}
            </div>
            <div>
              <h4 class="font-bold text-gray-900 text-sm mb-1">{item.title}</h4>
              <p class="text-xs text-gray-500">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 产品中心预览 -->
  <section class="section bg-gray-50/50">
    <div class="container-page">
      <div class="text-center">
        <span class="section-badge">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          产品中心
        </span>
      </div>
      <h2 class="section-title">全系列工业包装袋</h2>
      <p class="section-subtitle">十大产品系列，一站式满足防锈、防潮、防尘包装需求</p>

      <!-- 分类导航圆角入口 -->
      <div class="flex flex-wrap justify-center gap-3 mb-10">
        {PRODUCT_CATEGORIES.map((cat) => (
          <a
            href={`/products/#${cat.id}`}
            class="inline-flex items-center gap-2 px-5 py-3 bg-white rounded-2xl border border-gray-100 shadow-card hover:border-primary-200 hover:shadow-elevated transition-all duration-200 group"
          >
            <span class="text-xl">{
              cat.id === 'vci-rustproof' ? '🛡️' :
              cat.id === 'pe-bag' ? '📦' :
              cat.id === 'pp-bag' ? '📋' : '⭐'
            }</span>
            <span class="text-sm font-semibold text-gray-700 group-hover:text-primary-700 transition-colors">{cat.label}</span>
          </a>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {featuredProducts.map((product, i) => (
          <ProductCard
            id={product.id}
            name={product.name}
            category={product.category}
            categoryLabel={product.categoryLabel}
            description={product.description}
            features={product.features}
            image={product.image}
            index={i}
          />
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/products/" class="btn-outline-lg">
          查看全部产品
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 客户案例精选 -->
  <section class="section">
    <div class="container-page">
      <div class="text-center">
        <span class="section-badge-green">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          客户案例
        </span>
      </div>
      <h2 class="section-title">行业头部企业的共同选择</h2>
      <p class="section-subtitle">覆盖六大行业，用专业方案解决实际包装难题</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 mb-10">
        {featuredCases.map((c) => (
          <a href={`/cases/#${c.id}`} class="card-hover-lift block rounded-2xl overflow-hidden">
            <div class="bg-gradient-to-br from-gray-50 to-white p-5 border-b border-gray-50">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl bg-white shadow-sm border border-gray-100">
                  {c.industryIcon}
                </div>
                <div class="min-w-0">
                  <span class="badge-primary text-xs mb-1">{c.industry}</span>
                  <h3 class="font-bold text-gray-900 text-sm truncate group-hover:text-primary-700 transition-colors">{c.title}</h3>
                </div>
              </div>
            </div>
            <div class="p-5">
              <p class="text-sm text-gray-500 leading-relaxed mb-4 line-clamp-2">💡 {c.challenge.slice(0, 60)}...</p>
              <div class="flex flex-wrap gap-1.5">
                {c.tags.slice(0, 3).map((t) => (
                  <span class="badge-gray text-xs">{t}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center">
        <a href="/cases/" class="btn-outline-lg">
          查看全部案例
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 服务行业 -->
  <section class="section bg-gradient-to-br from-carbon-900 via-carbon-800 to-primary-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="relative container-page">
      <div class="text-center">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-semibold mb-4 bg-white/10 text-white border border-white/10">🏭 服务行业</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-center mb-4">深耕六大工业领域</h2>
      <p class="text-center text-white/60 max-w-2xl mx-auto mb-12 text-lg">每个行业都有独特的包装需求，我们提供精准匹配的解决方案</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {INDUSTRIES.map((ind) => (
          <div class="flex items-start gap-4 p-6 rounded-2xl bg-white/5 backdrop-blur-sm border border-white/10 hover:bg-white/10 transition-all duration-200 group">
            <div class="shrink-0 w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform duration-300">{
              ind.icon === 'car' ? '🚗' :
              ind.icon === 'battery' ? '🔋' :
              ind.icon === 'wrench' ? '🔧' :
              ind.icon === 'cube' ? '📐' :
              ind.icon === 'bolt' ? '⚡' : '⚙️'
            }</div>
            <div>
              <h3 class="font-bold text-white mb-1.5">{ind.name}</h3>
              <p class="text-sm text-white/50 leading-relaxed">{ind.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-gray-50/50">
    <div class="container-page">
      <div class="text-center">
        <span class="section-badge">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/></svg>
          常见问题
        </span>
      </div>
      <h2 class="section-title">您关心的问题</h2>
      <p class="section-subtitle">关于产品、定制、物流的常见疑问解答</p>

      <div class="max-w-3xl mx-auto space-y-3">
        {faqQuestions.map((faq, i) => (
          <details class="group bg-white rounded-2xl border border-gray-100 shadow-card overflow-hidden">
            <summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer hover:bg-gray-50/50 transition-colors list-none">
              <span class="font-semibold text-gray-900 pr-4">Q{i + 1}. {faq.question}</span>
              <span class="shrink-0 w-8 h-8 rounded-xl bg-gray-100 flex items-center justify-center group-open:bg-primary-100 group-open:text-primary-700 transition-all duration-200">
                <svg class="w-4 h-4 group-open:rotate-45 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                </svg>
              </span>
            </summary>
            <div class="px-5 sm:px-6 pb-5 sm:pb-6">
              <div class="bg-primary-50/50 rounded-xl p-4 text-sm text-gray-600 leading-relaxed border border-primary-100/50">{faq.answer}</div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 行动号召 -->
  <section class="section">
    <div class="container-page">
      <div class="relative bg-gradient-to-r from-primary-600 via-primary-700 to-primary-800 rounded-3xl p-10 sm:p-16 text-center text-white shadow-elevated overflow-hidden">
        <div class="absolute top-0 right-0 w-80 h-80 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>
        <div class="relative">
          <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">需要定制化的工业包装方案？</h2>
          <p class="text-white/70 mb-10 max-w-xl mx-auto text-lg">从需求分析、样品测试到批量交付，全程技术支持。源头生产，价格实在，交期有保障。</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="/contact/" class="btn-white !text-primary-700 text-lg px-10 py-4 rounded-2xl font-bold">
              📞 立即咨询获取报价
            </a>
            <a href="/about/" class="btn-outline-white">
              了解更多
            </a>
          </div>
          <p class="text-white/40 text-sm mt-6">或直接致电：{SITE.phone} ｜ 24小时内响应</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
